# Puppf sandbox — Gemini one-binary floor, round 2 (received 2026-11-10, verbatim).
# Source: sandbox/incoming/gemini-one-binary-floor-v2-2026-11-10.md
# Z fix (run #2 receipt 42879586450): the original pinned the KERNEL at 6.18.7
# but never selected the TOOLCHAIN's kernel headers — BR2_TOOLCHAIN_HEADERS_
# AT_LEAST fell back to its "2.6" floor while the linux-headers package
# installed 6.18.7, and Buildroot's strict ABI check aborted the build
# ("expected 2.6.x, got 6.18.x"). Headers now pinned to the kernel's version:
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_DEFAULT_KERNEL_HEADERS="6.18.7"
BR2_STATIC_LIBS=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_TARGET_ROOTFS_INITRAMFS=n
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_PACKAGE_BUSYBOX=y
BR2_ROOTFS_OVERLAY="board/puppf/overlay"
